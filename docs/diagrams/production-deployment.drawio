<mxfile host="app.diagrams.net" agent="dist-platform" version="24.7.17">
  <diagram id="prod-deploy-activity" name="Production deployment">
    <mxGraphModel dx="1720" dy="2200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="2200" math="0" shadow="0" background="#121212">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Production deployment — from a clean host to a served release" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#F2F2F2;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Lanes are who acts. Page 2 lists every container and every .env variable. See deploy/compose/ and docs/PLAN.md §4, §8, §10.1." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#A8A8A8;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1100" height="22" as="geometry" />
        </mxCell>

        <!-- ============================ lanes ============================ -->
        <mxCell id="laneOp" value="OPERATOR — shell on the service host" style="swimlane;horizontal=1;startSize=30;fillColor=#3B2E4A;strokeColor=#B39DDB;fontStyle=1;fontSize=12;align=center;fontColor=#EDE4F5;swimlaneFillColor=#1C1720;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="440" height="2020" as="geometry" />
        </mxCell>
        <mxCell id="laneOff" value="OFFLINE MACHINE — ceremony only, never on the service host" style="swimlane;horizontal=1;startSize=30;fillColor=#4A3A20;strokeColor=#E0A458;fontStyle=1;fontSize=12;align=center;fontColor=#F7E6CC;swimlaneFillColor=#201A11;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="400" height="2020" as="geometry" />
        </mxCell>
        <mxCell id="laneStack" value="COMPOSE STACK — the five containers of `dist-platform`" style="swimlane;horizontal=1;startSize=30;fillColor=#28442F;strokeColor=#7DC383;fontStyle=1;fontSize=12;align=center;fontColor=#DCEFDC;swimlaneFillColor=#141C16;" vertex="1" parent="1">
          <mxGeometry x="920" y="100" width="760" height="2020" as="geometry" />
        </mxCell>

        <!-- ============================ operator ============================ -->
        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#F2F2F2;strokeColor=#F2F2F2;" vertex="1" parent="laneOp">
          <mxGeometry x="200" y="45" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="op1" value="Provision the host&#10;Docker Engine + Compose v2, a TLS terminator,&#10;and a backup of the named volumes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#332A40;strokeColor=#B39DDB;fontColor=#EDE4F5;" vertex="1" parent="laneOp">
          <mxGeometry x="55" y="110" width="330" height="65" as="geometry" />
        </mxCell>
        <mxCell id="op2" value="cd deploy/compose &amp;&amp; cp .env.example .env&#10;(.env is gitignored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#332A40;strokeColor=#B39DDB;fontColor=#EDE4F5;" vertex="1" parent="laneOp">
          <mxGeometry x="55" y="200" width="330" height="55" as="geometry" />
        </mxCell>
        <mxCell id="op3" value="Fill in .env&#10;POSTGRES_PASSWORD is the only one the stack&#10;refuses to start without. Page 2 has the rest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24402B;strokeColor=#7DC383;fontStyle=1;fontColor=#DCEFDC;" vertex="1" parent="laneOp">
          <mxGeometry x="55" y="280" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="op4" value="Put the secrets in place, as files&#10;online.kdbx into the `signing-keys` volume;&#10;forge token and keystore password mounted at&#10;the paths *_FILE names" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#332A40;strokeColor=#B39DDB;fontColor=#EDE4F5;" vertex="1" parent="laneOp">
          <mxGeometry x="55" y="380" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="op5" value="DIST_BUILD_REF=$(git rev-parse --short HEAD) \&#10;DIST_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) \&#10;docker compose build&#10;— everything, not one service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#332A40;strokeColor=#B39DDB;fontColor=#EDE4F5;" vertex="1" parent="laneOp">
          <mxGeometry x="55" y="485" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="op6" value="docker compose up -d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#332A40;strokeColor=#B39DDB;fontStyle=1;fontColor=#EDE4F5;" vertex="1" parent="laneOp">
          <mxGeometry x="55" y="585" width="330" height="45" as="geometry" />
        </mxCell>
        <mxCell id="dHealth" value="edge, admin and&#10;postgres healthy?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#453A18;strokeColor=#D6B656;fontColor=#F7ECC6;" vertex="1" parent="laneOp">
          <mxGeometry x="135" y="1045" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="op7" value="Confirm which code is running&#10;`python -m dist_core.buildinfo` against the tree,&#10;/healthz on admin, and the worker's first log line —&#10;three matching `source` digests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#332A40;strokeColor=#B39DDB;fontColor=#EDE4F5;" vertex="1" parent="laneOp">
          <mxGeometry x="55" y="1190" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="op8" value="Sign in to the admin UI (through the TLS&#10;terminator) and register the source&#10;app id, project path, installer asset, tag prefix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#332A40;strokeColor=#B39DDB;fontColor=#EDE4F5;" vertex="1" parent="laneOp">
          <mxGeometry x="55" y="1300" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="dDeleg" value="app-&lt;id&gt; delegation&#10;published in&#10;targets.json?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#453A18;strokeColor=#D6B656;fontColor=#F7ECC6;" vertex="1" parent="laneOp">
          <mxGeometry x="125" y="1440" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="op9" value="uv run python -m dist_registry.delegate &lt;app-id&gt; --repo ./repo&#10;Signs nothing. Refuses unless the delegation is really&#10;there, then flips the source to `active`." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#332A40;strokeColor=#B39DDB;fontColor=#EDE4F5;" vertex="1" parent="laneOp">
          <mxGeometry x="45" y="1610" width="350" height="75" as="geometry" />
        </mxCell>
        <mxCell id="opNote" value="Both published ports default to 127.0.0.1.&#10;Exposing either means putting an authenticating&#10;TLS terminator in front — not changing the bind.&#10;Set ADMIN_SECURE_COOKIE=1 only once TLS is there." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#B9AFC4;" vertex="1" parent="laneOp">
          <mxGeometry x="55" y="655" width="340" height="75" as="geometry" />
        </mxCell>

        <!-- ============================ offline ============================ -->
        <mxCell id="koffline" value="offline.kdbx&#10;root + targets&#10;2-of-3, never on the service host" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#40301A;strokeColor=#E0A458;fontStyle=1;fontColor=#F7E6CC;" vertex="1" parent="laneOff">
          <mxGeometry x="105" y="105" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="off1" value="Initial ceremony — creates both keystores&#10;ENV=production uv run python scripts/ceremony.py \&#10;&#160;&#160;--out /mnt/offline/repo \&#10;&#160;&#160;--offline-db … --offline-keyfile … \&#10;&#160;&#160;--online-db … --online-keyfile …&#10;Refuses to proceed without a composite master key,&#10;and the key file must be on a different mount from&#10;the database. Passwords are read interactively." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#40301A;strokeColor=#E0A458;align=left;spacingLeft=10;fontColor=#F7E6CC;" vertex="1" parent="laneOff">
          <mxGeometry x="40" y="235" width="330" height="125" as="geometry" />
        </mxCell>
        <mxCell id="off2" value="Carry the signed metadata to the host&#10;root.json + targets.json into the `tuf-metadata`&#10;volume; online.kdbx into `signing-keys`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#40301A;strokeColor=#E0A458;fontColor=#F7E6CC;" vertex="1" parent="laneOff">
          <mxGeometry x="40" y="380" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="offNote" value="Automation stops at the ceremony by design.&#10;A web form cannot create a delegation: `targets`&#10;signs 2-of-3 offline (dist_core.roles.TARGETS_POLICY)&#10;and PLAN.md §8.2 forbids the admin plane from&#10;mutating TUF metadata at all." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#C7B294;" vertex="1" parent="laneOff">
          <mxGeometry x="40" y="485" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="off3" value="Delegation ceremony — once per application&#10;Add the app-&lt;id&gt; delegation to targets.json&#10;and re-sign it 2-of-3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#40301A;strokeColor=#E0A458;fontStyle=1;fontColor=#F7E6CC;" vertex="1" parent="laneOff">
          <mxGeometry x="40" y="1425" width="320" height="85" as="geometry" />
        </mxCell>
        <mxCell id="off4" value="Publish the new targets.json to the host&#10;(snapshot and timestamp are re-signed online)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#40301A;strokeColor=#E0A458;fontColor=#F7E6CC;" vertex="1" parent="laneOff">
          <mxGeometry x="40" y="1545" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="offNote2" value="An app registered as *critical* keeps offline key&#10;custody: every release stops at HOLD_FOR_CEREMONY,&#10;which is the point of marking it critical." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#C7B294;" vertex="1" parent="laneOff">
          <mxGeometry x="40" y="1645" width="340" height="60" as="geometry" />
        </mxCell>

        <!-- ============================ containers ============================ -->
        <mxCell id="stNote" value="One image, three entrypoints (admin, worker, signer) plus two stock images.&#10;None of them is given the Docker socket: socket access is host root, and host&#10;root is every volume including the keys." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#9EBCA2;" vertex="1" parent="laneStack">
          <mxGeometry x="50" y="45" width="560" height="60" as="geometry" />
        </mxCell>

        <mxCell id="stPg" value="postgres — postgres:18-alpine&#10;Starts first; everything else waits on `pg_isready`.&#10;No published port, `control` (internal) only.&#10;POSTGRES_PASSWORD · volume: postgres-data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24402B;strokeColor=#7DC383;align=left;spacingLeft=10;fontColor=#DCEFDC;" vertex="1" parent="laneStack">
          <mxGeometry x="50" y="555" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="stAdmin" value="admin — python -m dist_admin&#10;Creates the `admin` operator from&#10;ADMIN_BOOTSTRAP_PASSWORD, first start only.&#10;Listens on ADMIN_BIND:ADMIN_PORT → 8081.&#10;No signing key, no forge token, no route to a forge." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24402B;strokeColor=#7DC383;align=left;spacingLeft=10;fontColor=#DCEFDC;" vertex="1" parent="laneStack">
          <mxGeometry x="50" y="665" width="400" height="95" as="geometry" />
        </mxCell>
        <mxCell id="stWorker" value="worker — python -m dist_ingest.worker&#10;No inbound listener at all. Holds the read-only&#10;forge token; joins `control` and `forge`.&#10;Claims poll and validate jobs from the queue." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24402B;strokeColor=#7DC383;align=left;spacingLeft=10;fontColor=#DCEFDC;" vertex="1" parent="laneStack">
          <mxGeometry x="50" y="790" width="400" height="85" as="geometry" />
        </mxCell>
        <mxCell id="stSigner" value="signer — python -m dist_sign.worker&#10;Unlocks online.kdbx (DIST_ONLINE_KDBX_PASSWORD_FILE).&#10;No listener, no HTTP client, `control` only.&#10;The only container that mounts the repository rw." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24402B;strokeColor=#7DC383;align=left;spacingLeft=10;fontStyle=1;fontColor=#DCEFDC;" vertex="1" parent="laneStack">
          <mxGeometry x="50" y="905" width="400" height="85" as="geometry" />
        </mxCell>
        <mxCell id="stEdge" value="edge — nginx-unprivileged:1.27-alpine&#10;Serves /metadata and /targets as static files from&#10;read-only mounts. EDGE_BIND:EDGE_PORT → 8080.&#10;The only publicly reachable component." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24402B;strokeColor=#7DC383;align=left;spacingLeft=10;fontStyle=1;fontColor=#DCEFDC;" vertex="1" parent="laneStack">
          <mxGeometry x="50" y="1020" width="400" height="85" as="geometry" />
        </mxCell>

        <mxCell id="stFix" value="Read `docker compose logs`.&#10;A signer that exits immediately is almost always&#10;the keystore: `no keystore at /srv/keys/online.kdbx`&#10;means the `signing-keys` volume was never seeded.&#10;An admin login that returns to the login form is&#10;ADMIN_SECURE_COOKIE=1 without TLS in front." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#43201F;strokeColor=#E57373;align=left;spacingLeft=10;fontColor=#F7D9D7;" vertex="1" parent="laneStack">
          <mxGeometry x="490" y="1040" width="255" height="110" as="geometry" />
        </mxCell>

        <mxCell id="stValidate" value="admin queues a validate job; worker checks the&#10;project and pins its numeric repository id&#10;→ source reaches `pending_delegation` and stops&#10;Registering a source is not the same as trusting it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24402B;strokeColor=#7DC383;align=left;spacingLeft=10;fontColor=#DCEFDC;" vertex="1" parent="laneStack">
          <mxGeometry x="50" y="1300" width="400" height="85" as="geometry" />
        </mxCell>
        <mxCell id="stPoll" value="worker polls the release feed, downloads the asset,&#10;verifies the Sigstore attestation and quarantines it&#10;by digest, then runs the content gates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24402B;strokeColor=#7DC383;align=left;spacingLeft=10;fontColor=#DCEFDC;" vertex="1" parent="laneStack">
          <mxGeometry x="50" y="1720" width="400" height="75" as="geometry" />
        </mxCell>
        <mxCell id="dGate" value="content gates&#10;configured?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#453A18;strokeColor=#D6B656;fontColor=#F7ECC6;" vertex="1" parent="laneStack">
          <mxGeometry x="165" y="1830" width="170" height="95" as="geometry" />
        </mxCell>
        <mxCell id="stReject" value="Rejected — `gate failed: no malware scanner&#10;configured`. ContentGates fails closed: with&#10;DIST_SKIP_GATES empty every gate must be&#10;configured or ingestion refuses. A skipped gate&#10;is recorded as skipped, never as passed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#43201F;strokeColor=#E57373;align=left;spacingLeft=10;fontColor=#F7D9D7;" vertex="1" parent="laneStack">
          <mxGeometry x="490" y="1825" width="255" height="105" as="geometry" />
        </mxCell>
        <mxCell id="stSign" value="signer publishes: target → snapshot → timestamp last,&#10;into `tuf-targets` and `tuf-metadata`.&#10;edge serves the new metadata from its read-only mount." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24402B;strokeColor=#7DC383;align=left;spacingLeft=10;fontStyle=1;fontColor=#DCEFDC;" vertex="1" parent="laneStack">
          <mxGeometry x="50" y="1960" width="400" height="75" as="geometry" />
        </mxCell>
        <mxCell id="endOk" value="" style="ellipse;html=1;fillColor=#121212;strokeColor=#F2F2F2;strokeWidth=3;" vertex="1" parent="laneStack">
          <mxGeometry x="230" y="2065" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- ============================ edges ============================ -->
        <mxCell id="p1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C9C9C9;fontColor=#F2F2F2;" edge="1" parent="1" source="start" target="op1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C9C9C9;fontColor=#F2F2F2;" edge="1" parent="1" source="op1" target="op2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C9C9C9;fontColor=#F2F2F2;" edge="1" parent="1" source="op2" target="op3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C9C9C9;fontColor=#F2F2F2;" edge="1" parent="1" source="op3" target="op4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C9C9C9;fontColor=#F2F2F2;" edge="1" parent="1" source="op4" target="op5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C9C9C9;fontColor=#F2F2F2;" edge="1" parent="1" source="op5" target="op6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E0A458;fontColor=#F7E6CC;" edge="1" parent="1" source="koffline" target="off1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E0A458;fontColor=#F7E6CC;" edge="1" parent="1" source="off1" target="off2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p9" value="signed root.json + targets.json,&#10;and online.kdbx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E0A458;dashed=1;fontSize=10;fontColor=#F7E6CC;labelBackgroundColor=#121212;align=left;spacingLeft=6;" edge="1" parent="1" source="off2" target="op4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p10" value="starts the stack" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontColor=#F2F2F2;labelBackgroundColor=#121212;strokeColor=#E8E8E8;strokeWidth=2;" edge="1" parent="1" source="op6" target="stPg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="708" /><mxPoint x="740" y="695" /></Array></mxGeometry></mxCell>
        <mxCell id="p11" value="depends_on: service_healthy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#DCEFDC;labelBackgroundColor=#121212;strokeColor=#7DC383;" edge="1" parent="1" source="stPg" target="stAdmin"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7DC383;" edge="1" parent="1" source="stAdmin" target="stWorker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7DC383;" edge="1" parent="1" source="stWorker" target="stSigner"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7DC383;" edge="1" parent="1" source="stSigner" target="stEdge"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C9C9C9;" edge="1" parent="1" source="stEdge" target="dHealth"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="1185" /><mxPoint x="260" y="1185" /></Array></mxGeometry></mxCell>

        <mxCell id="p16" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E57373;fontSize=11;fontColor=#F7D9D7;labelBackgroundColor=#121212;" edge="1" parent="1" source="dHealth" target="stFix"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="1010" /><mxPoint x="1537" y="1010" /></Array></mxGeometry></mxCell>
        <mxCell id="p17" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontColor=#F2F2F2;labelBackgroundColor=#121212;strokeColor=#C9C9C9;" edge="1" parent="1" source="dHealth" target="op7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C9C9C9;" edge="1" parent="1" source="op7" target="op8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p19" value="queued job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#F2F2F2;labelBackgroundColor=#121212;strokeColor=#C9C9C9;" edge="1" parent="1" source="op8" target="stValidate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C9C9C9;" edge="1" parent="1" source="stValidate" target="dDeleg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="1465" /><mxPoint x="920" y="1465" /><mxPoint x="920" y="1595" /><mxPoint x="260" y="1595" /></Array></mxGeometry></mxCell>

        <mxCell id="p21" value="no — ceremony required" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E0A458;fontSize=11;fontColor=#F7E6CC;labelBackgroundColor=#121212;" edge="1" parent="1" source="dDeleg" target="off3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E0A458;" edge="1" parent="1" source="off3" target="off4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p23" value="published" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E0A458;dashed=1;fontSize=11;fontColor=#F7E6CC;labelBackgroundColor=#121212;" edge="1" parent="1" source="off4" target="dDeleg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="1750" /><mxPoint x="260" y="1750" /></Array></mxGeometry></mxCell>
        <mxCell id="p24" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontColor=#F2F2F2;labelBackgroundColor=#121212;strokeColor=#C9C9C9;" edge="1" parent="1" source="dDeleg" target="op9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p25" value="source becomes `active`" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#F2F2F2;labelBackgroundColor=#121212;strokeColor=#E8E8E8;strokeWidth=2;" edge="1" parent="1" source="op9" target="stPoll"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7DC383;" edge="1" parent="1" source="stPoll" target="dGate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E57373;fontSize=11;fontColor=#F7D9D7;labelBackgroundColor=#121212;" edge="1" parent="1" source="dGate" target="stReject"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p28" value="yes — promoted, publish job queued" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontColor=#DCEFDC;labelBackgroundColor=#121212;strokeColor=#7DC383;align=left;spacingLeft=6;" edge="1" parent="1" source="dGate" target="stSign"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p29" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C9C9C9;" edge="1" parent="1" source="stSign" target="endOk"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="prod-deploy-config" name="Containers and .env configuration">
    <mxGraphModel dx="1720" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1500" math="0" shadow="0" background="#121212">
      <root>
        <mxCell id="c0" />
        <mxCell id="c1" parent="c0" />

        <mxCell id="ctitle" value="Every container, and every variable that has to be set" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#F2F2F2;" vertex="1" parent="c1">
          <mxGeometry x="40" y="20" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="csub" value="Source of truth: deploy/compose/docker-compose.yml, deploy/compose/Dockerfile, deploy/compose/.env.example. Compose project name: `dist-platform`." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#A8A8A8;" vertex="1" parent="c1">
          <mxGeometry x="40" y="48" width="1200" height="22" as="geometry" />
        </mxCell>

        <!-- ============================ containers ============================ -->
        <mxCell id="cEdge" value="&lt;b&gt;edge&lt;/b&gt;&lt;br&gt;&lt;i&gt;nginxinc/nginx-unprivileged:1.27-alpine&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;port&lt;/b&gt; ${EDGE_BIND:-127.0.0.1}:${EDGE_PORT:-8080} → 8080&lt;br&gt;&lt;b&gt;network&lt;/b&gt; edge&lt;br&gt;&lt;b&gt;env&lt;/b&gt; none&lt;br&gt;&lt;b&gt;volumes&lt;/b&gt;&lt;br&gt;· nginx/edge.conf :ro&lt;br&gt;· nginx/security-headers.conf :ro&lt;br&gt;· tuf-metadata :ro&lt;br&gt;· tuf-targets :ro&lt;br&gt;&lt;b&gt;tmpfs&lt;/b&gt; /tmp, /var/cache/nginx, /var/run&lt;br&gt;&lt;b&gt;healthcheck&lt;/b&gt; wget /healthz&lt;br&gt;&lt;br&gt;Holds nothing. Read-only by mount, not by config." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24402B;strokeColor=#7DC383;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#DCEFDC;" vertex="1" parent="c1">
          <mxGeometry x="40" y="90" width="320" height="300" as="geometry" />
        </mxCell>
        <mxCell id="cAdmin" value="&lt;b&gt;admin&lt;/b&gt;&lt;br&gt;&lt;i&gt;built: Dockerfile target `admin` — python -m dist_admin&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;port&lt;/b&gt; ${ADMIN_BIND:-127.0.0.1}:${ADMIN_PORT:-8081} → 8081&lt;br&gt;&lt;b&gt;networks&lt;/b&gt; front, control&lt;br&gt;&lt;b&gt;env&lt;/b&gt;&lt;br&gt;· DIST_DATABASE_URL&lt;br&gt;· DIST_ADMIN_HOST / DIST_ADMIN_PORT&lt;br&gt;· DIST_ADMIN_BOOTSTRAP_PASSWORD&lt;br&gt;· DIST_ADMIN_SECURE_COOKIE&lt;br&gt;&lt;b&gt;volumes&lt;/b&gt; none (tmpfs /tmp)&lt;br&gt;&lt;b&gt;healthcheck&lt;/b&gt; GET /healthz&lt;br&gt;&lt;br&gt;No signing key, no forge token, and no code path to either — dist_admin does not import dist_ingest." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24402B;strokeColor=#7DC383;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#DCEFDC;" vertex="1" parent="c1">
          <mxGeometry x="372" y="90" width="320" height="300" as="geometry" />
        </mxCell>
        <mxCell id="cWorker" value="&lt;b&gt;worker&lt;/b&gt; (ingest)&lt;br&gt;&lt;i&gt;built: target `worker` — python -m dist_ingest.worker&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;port&lt;/b&gt; none — no inbound listener&lt;br&gt;&lt;b&gt;networks&lt;/b&gt; control, forge (outbound)&lt;br&gt;&lt;b&gt;env&lt;/b&gt;&lt;br&gt;· DIST_DATABASE_URL&lt;br&gt;· DIST_QUARANTINE_DIR&lt;br&gt;· DIST_FORGE_TOKEN_FILE / DIST_FORGE_TOKEN&lt;br&gt;· DIST_SKIP_GATES&lt;br&gt;· DIST_LOG_LEVEL&lt;br&gt;· XDG_CACHE_HOME + XDG_DATA_HOME (sigstore)&lt;br&gt;&lt;b&gt;volumes&lt;/b&gt; quarantine, sigstore-cache, sigstore-data&lt;br&gt;&lt;br&gt;Holds the read-only forge credential." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24402B;strokeColor=#7DC383;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#DCEFDC;" vertex="1" parent="c1">
          <mxGeometry x="704" y="90" width="320" height="300" as="geometry" />
        </mxCell>
        <mxCell id="cSigner" value="&lt;b&gt;signer&lt;/b&gt;&lt;br&gt;&lt;i&gt;built: target `signer` — python -m dist_sign.worker&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;port&lt;/b&gt; none — no listener, no HTTP client&lt;br&gt;&lt;b&gt;network&lt;/b&gt; control&lt;br&gt;&lt;b&gt;env&lt;/b&gt;&lt;br&gt;· DIST_DATABASE_URL&lt;br&gt;· DIST_REPO_DIR / DIST_QUARANTINE_DIR&lt;br&gt;· DIST_ONLINE_KDBX (/srv/keys/online.kdbx)&lt;br&gt;· DIST_ONLINE_KDBX_PASSWORD_FILE / _PASSWORD&lt;br&gt;· DIST_ONLINE_KDBX_KEYFILE&lt;br&gt;· DIST_LOG_LEVEL&lt;br&gt;&lt;b&gt;volumes&lt;/b&gt; tuf-metadata &lt;b&gt;rw&lt;/b&gt;, tuf-targets &lt;b&gt;rw&lt;/b&gt;,&lt;br&gt;&#160;&#160;quarantine :ro, signing-keys :ro&lt;br&gt;&lt;br&gt;Online keys only. root and targets are absent by construction, so it can publish a release and cannot create a delegation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24402B;strokeColor=#7DC383;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#DCEFDC;" vertex="1" parent="c1">
          <mxGeometry x="1036" y="90" width="320" height="300" as="geometry" />
        </mxCell>
        <mxCell id="cPg" value="&lt;b&gt;postgres&lt;/b&gt;&lt;br&gt;&lt;i&gt;postgres:18-alpine&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;port&lt;/b&gt; not published&lt;br&gt;&lt;b&gt;network&lt;/b&gt; control (internal — no route off the host)&lt;br&gt;&lt;b&gt;env&lt;/b&gt;&lt;br&gt;· POSTGRES_USER=dist&lt;br&gt;· POSTGRES_DB=dist&lt;br&gt;· POSTGRES_PASSWORD&lt;br&gt;&lt;b&gt;volumes&lt;/b&gt; postgres-data → /var/lib/postgresql&lt;br&gt;&lt;b&gt;healthcheck&lt;/b&gt; pg_isready -U dist -d dist&lt;br&gt;&lt;br&gt;Source registry, job queue and audit log — no keys and no TUF metadata. Losing it costs the registry, not the trust root." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24402B;strokeColor=#7DC383;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#DCEFDC;" vertex="1" parent="c1">
          <mxGeometry x="1368" y="90" width="320" height="300" as="geometry" />
        </mxCell>

        <mxCell id="cHard" value="All four non-database services run `read_only: true`, `cap_drop: [ALL]`, `no-new-privileges:true`, as uid 10001. No container is given the Docker socket." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#A8A8A8;" vertex="1" parent="c1">
          <mxGeometry x="40" y="398" width="1000" height="22" as="geometry" />
        </mxCell>

        <!-- ============================ networks / volumes ============================ -->
        <mxCell id="cNets" value="&lt;b&gt;Networks&lt;/b&gt;&lt;br&gt;&lt;b&gt;edge&lt;/b&gt; — carries the public port. edge only.&lt;br&gt;&lt;b&gt;front&lt;/b&gt; — carries the admin port. admin only.&lt;br&gt;&lt;b&gt;control&lt;/b&gt; — &lt;b&gt;internal&lt;/b&gt;. admin, worker, signer, postgres.&lt;br&gt;&lt;b&gt;forge&lt;/b&gt; — the worker's outbound path, so that reaching a forge and reaching the database are distinct capabilities.&lt;br&gt;&lt;br&gt;&lt;i&gt;A published port needs a non-internal network, which also grants ordinary outbound access — so `admin` is not egress-isolated and this stack does not claim it is. Its separation is capability-shaped: no token, no key, no code path.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B2C3E;strokeColor=#7AA7D9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#DCE9F7;" vertex="1" parent="c1">
          <mxGeometry x="40" y="430" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cVols" value="&lt;b&gt;Volumes&lt;/b&gt; (all named; back these up)&lt;br&gt;&lt;b&gt;tuf-metadata, tuf-targets&lt;/b&gt; — signer rw, edge :ro&lt;br&gt;&lt;b&gt;quarantine&lt;/b&gt; — worker rw, signer :ro. Content-addressed, never served.&lt;br&gt;&lt;b&gt;signing-keys&lt;/b&gt; — signer :ro. Holds online.kdbx. &lt;b&gt;Nothing seeds it&lt;/b&gt; — see the notes.&lt;br&gt;&lt;b&gt;postgres-data&lt;/b&gt; — postgres, mounted at /var/lib/postgresql (18 nests the cluster by major version inside it)&lt;br&gt;&lt;b&gt;sigstore-cache, sigstore-data&lt;/b&gt; — worker. Sigstore's TUF trust root: cache, safe to delete, costs a refetch.&lt;br&gt;&lt;br&gt;&lt;i&gt;offline.kdbx (root + targets) is deliberately not represented in the stack at all.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#40301A;strokeColor=#E0A458;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#F7E6CC;" vertex="1" parent="c1">
          <mxGeometry x="560" y="430" width="480" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cDev" value="&lt;b&gt;Overrides that are not production&lt;/b&gt;&lt;br&gt;&lt;b&gt;docker-compose.dev.yml&lt;/b&gt; — replaces the edge's volume mounts with a host repository (`REPO_DIR`, default ../../repo). Still :ro.&lt;br&gt;&lt;b&gt;docker-compose.test.yml&lt;/b&gt; — a throwaway `postgres-test` on 127.0.0.1:${TEST_PG_PORT:-15432} for the store tests. Run it under `-p dist-test`; it TRUNCATEs every table.&lt;br&gt;&lt;br&gt;&lt;i&gt;Neither belongs in a production `docker compose up`.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#242424;strokeColor=#8A8A8A;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#D6D6D6;" vertex="1" parent="c1">
          <mxGeometry x="1060" y="430" width="628" height="200" as="geometry" />
        </mxCell>

        <!-- ============================ env table ============================ -->
        <mxCell id="cEnvTitle" value="deploy/compose/.env — what a production deployment sets" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#F2F2F2;" vertex="1" parent="c1">
          <mxGeometry x="40" y="650" width="700" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cEnv" value="&lt;table cellpadding='4' cellspacing='0' style='width:100%;border-collapse:collapse;font-size:11px;color:#E4E4E4'&gt;&lt;tr style='background:#2E2E2E'&gt;&lt;th align='left' width='31%'&gt;Variable&lt;/th&gt;&lt;th align='left' width='16%'&gt;Status&lt;/th&gt;&lt;th align='left'&gt;What it does, and how it fails when wrong&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;POSTGRES_PASSWORD&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;required&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Interpolated as ${POSTGRES_PASSWORD:?} in four places — compose refuses to start rather than defaulting, because a default database password is the kind of thing that survives into production unnoticed.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#1E1E1E'&gt;&lt;td&gt;&lt;b&gt;ONLINE_KDBX_PASSWORD_FILE&lt;/b&gt;&lt;br&gt;(or ONLINE_KDBX_PASSWORD)&lt;/td&gt;&lt;td&gt;&lt;b&gt;required to sign&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Unlocks online.kdbx — snapshot, timestamp and the per-app roles. Prefer the file form: an env var is inherited by every child process and lands in a crash dump. &lt;b&gt;Not in .env.example.&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ONLINE_KDBX_KEYFILE&lt;/td&gt;&lt;td&gt;required in practice&lt;/td&gt;&lt;td&gt;The keystore's second factor. `ENV=production scripts/ceremony.py` refuses to run without a composite master key, so a production online.kdbx has one — and the signer cannot open it without this. Mount it from a different volume than the database, as the ceremony required.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#1E1E1E'&gt;&lt;td&gt;FORGE_TOKEN_FILE&lt;br&gt;(or FORGE_TOKEN)&lt;/td&gt;&lt;td&gt;strongly advised&lt;/td&gt;&lt;td&gt;Read-only forge credential. Without it public GitHub allows 60 requests/hour per address and one poll spends two; the symptom is `403 rate limit exceeded`. A fine-grained *public repositories, read-only* token raises it to 5000/hr. Nothing here writes to a forge.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ADMIN_BOOTSTRAP_PASSWORD&lt;/td&gt;&lt;td&gt;first start only&lt;/td&gt;&lt;td&gt;Creates the `admin` operator and is ignored once any operator exists, so leaving it set cannot reset a password. Leave empty and use `python -m dist_admin.operators add &amp;lt;name&amp;gt;` to keep it out of a file.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#1E1E1E'&gt;&lt;td&gt;&lt;b&gt;ADMIN_SECURE_COOKIE&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;set to 1&lt;/b&gt; (default 0)&lt;/td&gt;&lt;td&gt;Set to 1 only when the admin plane is behind TLS. A Secure cookie is never sent over loopback HTTP, which presents as a login form that accepts the password and returns you to the login form.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SKIP_GATES&lt;/td&gt;&lt;td&gt;deliberate choice&lt;/td&gt;&lt;td&gt;Names the gates this deployment does not run, one by one. Empty means every gate must be configured or ingestion refuses; a skipped gate is recorded as skipped, never as passed. &lt;b&gt;Not in .env.example.&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#1E1E1E'&gt;&lt;td&gt;EDGE_BIND / EDGE_PORT&lt;/td&gt;&lt;td&gt;default 127.0.0.1:8080&lt;/td&gt;&lt;td&gt;Where the public edge listens on the host. Keep it on loopback and put the TLS terminator in front.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ADMIN_BIND / ADMIN_PORT&lt;/td&gt;&lt;td&gt;default 127.0.0.1:8081&lt;/td&gt;&lt;td&gt;Same, for the operator UI. PLAN.md §2 gives the admin plane no inbound path from clients at all — exposing it means an authenticating terminator, not a wider bind.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#1E1E1E'&gt;&lt;td&gt;LOG_LEVEL&lt;/td&gt;&lt;td&gt;default INFO&lt;/td&gt;&lt;td&gt;Passed to worker and signer as DIST_LOG_LEVEL.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DIST_BUILD_REF&lt;br&gt;DIST_BUILD_TIME&lt;/td&gt;&lt;td&gt;build args, optional&lt;/td&gt;&lt;td&gt;Set at build time and a stale container names the revision it is running. Left empty, the content digest still answers &quot;is this container running my tree&quot;.&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#1E1E1E'&gt;&lt;td&gt;REPO_DIR / TEST_PG_PORT&lt;/td&gt;&lt;td&gt;not production&lt;/td&gt;&lt;td&gt;Only read by the dev and test override files.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#191919;strokeColor=#6E6E6E;align=left;verticalAlign=top;spacingLeft=4;spacingTop=4;overflow=fill;fontColor=#E4E4E4;" vertex="1" parent="c1">
          <mxGeometry x="40" y="680" width="1000" height="700" as="geometry" />
        </mxCell>

        <!-- ============================ gaps ============================ -->
        <mxCell id="cGapsTitle" value="Configuration this stack does not do for you" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#F2F2F2;" vertex="1" parent="c1">
          <mxGeometry x="1060" y="650" width="628" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cGap1" value="&lt;b&gt;1 — The `signing-keys` volume is empty.&lt;/b&gt;&lt;br&gt;It is a named volume that nothing seeds. Put online.kdbx in it before the signer starts, or the container exits with `no keystore at /srv/keys/online.kdbx`. Docker seeds a &lt;i&gt;fresh&lt;/i&gt; named volume from the image, ownership included; a volume that already exists keeps what it had." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#43201F;strokeColor=#E57373;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#F7D9D7;" vertex="1" parent="c1">
          <mxGeometry x="1060" y="680" width="628" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cGap2" value="&lt;b&gt;2 — The *_FILE forms name a path inside the container.&lt;/b&gt;&lt;br&gt;docker-compose.yml has no `secrets:` section and mounts nothing at /run/secrets, so setting FORGE_TOKEN_FILE=/run/secrets/forge_token as .env.example suggests also means adding the mount (or a Docker secret). Until then the file is simply not there and the credential is absent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#43201F;strokeColor=#E57373;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#F7D9D7;" vertex="1" parent="c1">
          <mxGeometry x="1060" y="800" width="628" height="115" as="geometry" />
        </mxCell>
        <mxCell id="cGap3" value="&lt;b&gt;3 — No TLS anywhere in the stack.&lt;/b&gt;&lt;br&gt;Both published ports are plain HTTP on loopback. Production needs a terminator in front of `edge` (public) and in front of `admin` (operators only, authenticating), and ADMIN_SECURE_COOKIE=1 once it is there." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#40301A;strokeColor=#E0A458;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#F7E6CC;" vertex="1" parent="c1">
          <mxGeometry x="1060" y="925" width="628" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cGap4" value="&lt;b&gt;4 — The content gates fail closed, and one is unwired.&lt;/b&gt;&lt;br&gt;A source can be `active` and still refuse every release: with no malware scanner configured, ingestion rejects with `gate failed: no malware scanner configured`. That is the gate declining to pretend it ran — wiring a scanner is outstanding Phase 3 work. Decide between a scanner and an explicit SKIP_GATES entry before going live." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#40301A;strokeColor=#E0A458;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#F7E6CC;" vertex="1" parent="c1">
          <mxGeometry x="1060" y="1030" width="628" height="115" as="geometry" />
        </mxCell>
        <mxCell id="cGap5" value="&lt;b&gt;5 — Rebuild everything, not one service.&lt;/b&gt;&lt;br&gt;admin, worker and signer are three targets of one image sharing dist-core, dist-registry and dist-ingest. `docker compose build admin` after editing shared code leaves the other two on the older tree, reporting failures that describe code no longer on disk. Plain `docker compose build` rebuilds all three." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#453A18;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#F7ECC6;" vertex="1" parent="c1">
          <mxGeometry x="1060" y="1155" width="628" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cGap6" value="&lt;b&gt;6 — Egress is a decision, not a detail.&lt;/b&gt;&lt;br&gt;`worker` joins a `forge` network with outbound access. A self-hosted GitLab keeps that inside the perimeter; registering a github.com source puts public internet egress into the publish path, which retires the &quot;allowlist of one internal host&quot; property PLAN.md §4.1 claims. The per-source allowlist is derived from the API base an operator typed, so a database row cannot name a new destination." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#453A18;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#F7ECC6;" vertex="1" parent="c1">
          <mxGeometry x="1060" y="1275" width="628" height="125" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

        </mxCell>
        <mxCell id="appCpp" value="C / C++ app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneCli">
          <mxGeometry x="620" y="42" width="120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="sdk" value="language SDK — check / notify / consent only, no verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneCli">
          <mxGeometry x="100" y="112" width="640" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ffi" value="dist-core-ffi&#10;C ABI — all unsafe code lives here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneCli">
          <mxGeometry x="100" y="180" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="core" value="dist-core (Rust)&#10;ONE TUF verifier — forked tuf crate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="laneCli">
          <mxGeometry x="420" y="180" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="shim" value="launcher shim&#10;stable path, resolves pointer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneCli">
          <mxGeometry x="820" y="112" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="installer" value="installer&#10;A/B slots + pointer flip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneCli">
          <mxGeometry x="820" y="180" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="broker" value="dist-service-win (SYSTEM)&#10;privileged broker — system-wide installs&#10;accepts verbs only, no parameters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="laneCli">
          <mxGeometry x="1080" y="180" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cliNote" value="Per-user installs need no privileged helper at all.&#10;The broker exists only for system-wide (§6.2)." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="laneCli">
          <mxGeometry x="1400" y="180" width="440" height="55" as="geometry" />
        </mxCell>

        <!-- ============================ telemetry ============================ -->
        <mxCell id="tingest" value="telemetry ingest&#10;write-only, INSERT-only grants&#10;holds no credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="laneTel">
          <mxGeometry x="100" y="42" width="220" height="78" as="geometry" />
        </mxCell>
        <mxCell id="tdb" value="telemetry-db&#10;update outcomes" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneTel">
          <mxGeometry x="360" y="38" width="160" height="85" as="geometry" />
        </mxCell>
        <mxCell id="crash" value="crash service&#10;(self-hosted Sentry)&#10;opt-in dumps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneTel">
          <mxGeometry x="560" y="42" width="190" height="78" as="geometry" />
        </mxCell>
        <mxCell id="dump" value="dump processor&#10;sandboxed, no egress&#10;hostile input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneTel">
          <mxGeometry x="790" y="42" width="190" height="78" as="geometry" />
        </mxCell>
        <mxCell id="telNote" value="TUF secures downloads. It gives nothing on this path (§2.1),&#10;so integrity here rests on signed reports, TLS pinning and limits." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="laneTel">
          <mxGeometry x="1400" y="48" width="450" height="60" as="geometry" />
        </mxCell>

        <!-- ============================ admin ============================ -->
        <mxCell id="adminui" value="admin UI&#10;server-rendered, read-mostly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="laneAdm">
          <mxGeometry x="100" y="45" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="control queue&#10;pause, rollback, revoke&#10;two-person approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="laneAdm">
          <mxGeometry x="330" y="45" width="190" height="70" as="geometry" />

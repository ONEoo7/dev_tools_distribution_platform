        <mxCell id="f22" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="a1" source="dHealthy" target="rollback"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f23" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="a1" source="dHealthy" target="confirm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="a1" source="confirm" target="endOk"><mxGeometry relative="1" as="geometry" /></mxCell>

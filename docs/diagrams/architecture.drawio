          </mxGeometry>
        </mxCell>

        <mxCell id="e28" value="sanitised export" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#9673a6;fontSize=10;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1" source="cluster" target="review">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e29" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#666666;" edge="1" parent="1" source="review" target="issue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e30" value="verify-stage failures bypass review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cluster" target="paging">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="715" y="1195" /><mxPoint x="1530" y="1195" /></Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="update-activity" name="Update activity">
    <mxGraphModel dx="1200" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1820" math="0" shadow="0">
      <root>
        <mxCell id="a0" />
        <mxCell id="a1" parent="a0" />

        <mxCell id="atitle" value="Update activity — check to relaunch" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1" vertex="1" parent="a1">
          <mxGeometry x="40" y="15" width="700" height="26" as="geometry" />
        </mxCell>
        <mxCell id="asub" value="Every failure path ends in a usable installation. See docs/PLAN.md §5.3 and §6.1." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2" vertex="1" parent="a1">
          <mxGeometry x="40" y="41" width="700" height="22" as="geometry" />
        </mxCell>

        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="a1">
          <mxGeometry x="300" y="90" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="check" value="App asks the service whether&#10;a newer version exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a1">
          <mxGeometry x="190" y="160" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dAvail" value="update&#10;available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="a1">
          <mxGeometry x="250" y="250" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dRollout" value="inside signed&#10;rollout %?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="a1">
          <mxGeometry x="250" y="375" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="notify" value="Show small in-app notification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a1">
          <mxGeometry x="190" y="500" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dConsent" value="user&#10;consents?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="a1">
          <mxGeometry x="250" y="585" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dManaged" value="managed&#10;mode?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="a1">
          <mxGeometry x="250" y="710" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="download" value="Download payload&#10;(the broker fetches for itself when system-wide)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a1">
          <mxGeometry x="170" y="835" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="Verify — TUF metadata and hash,&#10;then platform signature,&#10;then publisher matches installed app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="a1">
          <mxGeometry x="170" y="925" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dVerified" value="verified?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="a1">
          <mxGeometry x="250" y="1030" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stage" value="Stage into a temporary directory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a1">
          <mxGeometry x="190" y="1155" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="commit" value="Rename into place as a version slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a1">
          <mxGeometry x="190" y="1235" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="reverify" value="Re-verify the staged bytes&#10;immediately before use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="a1">
          <mxGeometry x="190" y="1315" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="flip" value="Flip the pointer (atomic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a1">
          <mxGeometry x="190" y="1400" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="exit" value="App exits; launcher shim resolves&#10;the pointer and starts the new version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="a1">
          <mxGeometry x="180" y="1480" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dHealthy" value="confirmed&#10;within 3&#10;attempts?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="a1">
          <mxGeometry x="250" y="1570" width="140" height="100" as="geometry" />
        </mxCell>
        <mxCell id="confirm" value="Confirm healthy; prune old slots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="a1">
          <mxGeometry x="190" y="1700" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="endOk" value="" style="ellipse;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;" vertex="1" parent="a1">
          <mxGeometry x="300" y="1775" width="40" height="40" as="geometry" />
        </mxCell>

        <mxCell id="idle" value="Nothing to do — try again later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="a1">
          <mxGeometry x="640" y="268" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="defer" value="Deferred — the user decides,&#10;the update is never forced" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="a1">
          <mxGeometry x="640" y="603" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="managed" value="Report only — installation is&#10;deferred to management tooling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="a1">
          <mxGeometry x="640" y="728" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="reject" value="Discard the payload;&#10;report a verify-stage failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="a1">
          <mxGeometry x="640" y="1048" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pageSec" value="Security paging — a spike here means&#10;a tampered mirror or a botched signing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="a1">
          <mxGeometry x="640" y="1140" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rollback" value="Auto-rollback to the previous slot&#10;and mark it confirmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="a1">
          <mxGeometry x="640" y="1593" width="270" height="55" as="geometry" />
        </mxCell>
        <mxCell id="telemetry" value="Every outcome — success or failure —&#10;is reported to the telemetry plane" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="a1">
          <mxGeometry x="640" y="1700" width="290" height="55" as="geometry" />
        </mxCell>
        <mxCell id="killNote" value="Interrupted anywhere above the pointer flip, the old version&#10;is still active. Interrupted at the flip, one version or the&#10;other — never a mixture. See client/dist-core-rs/tests/install.rs." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="a1">
          <mxGeometry x="640" y="1270" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="a1" source="start" target="check"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="a1" source="check" target="dAvail"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="a1" source="dAvail" target="idle"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="a1" source="dAvail" target="dRollout"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="a1" source="dRollout" target="idle"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="420" /><mxPoint x="560" y="296" /></Array></mxGeometry></mxCell>
        <mxCell id="f6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="a1" source="dRollout" target="notify"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="a1" source="notify" target="dConsent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="a1" source="dConsent" target="defer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="a1" source="dConsent" target="dManaged"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="a1" source="dManaged" target="managed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="a1" source="dManaged" target="download"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="a1" source="download" target="verify"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="a1" source="verify" target="dVerified"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f14" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="a1" source="dVerified" target="reject"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;" edge="1" parent="a1" source="reject" target="pageSec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="a1" source="dVerified" target="stage"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="a1" source="stage" target="commit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="a1" source="commit" target="reverify"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="a1" source="reverify" target="flip"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="a1" source="flip" target="exit"><mxGeometry relative="1" as="geometry" /></mxCell>

<mxfile host="app.diagrams.net" agent="dist-platform" version="24.7.17">
  <diagram id="arch-overview" name="Architecture overview">
    <mxGraphModel dx="2000" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Software distribution platform — architecture and information flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="900" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Lanes are trust boundaries. Arrows are labelled with what flows. See docs/PLAN.md §2." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="38" width="900" height="22" as="geometry" />
        </mxCell>

        <!-- ============================ lanes ============================ -->
        <mxCell id="laneExt" value="EXTERNAL FORGE — read-only, outside the trust boundary" style="swimlane;horizontal=1;startSize=28;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;align=left;spacingLeft=12;swimlaneFillColor=#fdf6f6;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1900" height="150" as="geometry" />
        </mxCell>
        <mxCell id="laneDist" value="DISTRIBUTION PLANE — holds signing keys, no inbound from clients" style="swimlane;horizontal=1;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;align=left;spacingLeft=12;swimlaneFillColor=#f7fbf7;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1900" height="310" as="geometry" />
        </mxCell>
        <mxCell id="laneCli" value="CLIENT — user machine" style="swimlane;horizontal=1;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;align=left;spacingLeft=12;swimlaneFillColor=#f7fafd;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1900" height="340" as="geometry" />
        </mxCell>
        <mxCell id="laneTel" value="TELEMETRY PLANE — write-only, holds no credentials" style="swimlane;horizontal=1;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;align=left;spacingLeft=12;swimlaneFillColor=#fffdf7;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="1900" height="180" as="geometry" />
        </mxCell>
        <mxCell id="laneAdm" value="ADMIN PLANE — operators only" style="swimlane;horizontal=1;startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;align=left;spacingLeft=12;swimlaneFillColor=#fbf9fc;" vertex="1" parent="1">
          <mxGeometry x="40" y="1050" width="1900" height="190" as="geometry" />
        </mxCell>
        <mxCell id="laneOff" value="OFFLINE — ceremony only, never on the service host" style="swimlane;horizontal=1;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;align=left;spacingLeft=12;swimlaneFillColor=#fffbf5;" vertex="1" parent="1">
          <mxGeometry x="40" y="1240" width="1900" height="150" as="geometry" />
        </mxCell>

        <!-- ============================ external ============================ -->
        <mxCell id="gitlab" value="GitLab (self-hosted)&#10;releases + attestations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="laneExt">
          <mxGeometry x="100" y="45" width="190" height="65" as="geometry" />
        </mxCell>
        <mxCell id="github" value="GitHub&#10;optional (§4.2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="laneExt">
          <mxGeometry x="320" y="45" width="170" height="65" as="geometry" />
        </mxCell>
        <mxCell id="ci" value="CI pipeline&#10;builds + signs SLSA provenance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="laneExt">
          <mxGeometry x="530" y="45" width="210" height="65" as="geometry" />
        </mxCell>
        <mxCell id="extNote" value="No component in this system writes to a forge.&#10;dist-ingest's token is read-only (§8.4)." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" vertex="1" parent="laneExt">
          <mxGeometry x="1400" y="50" width="440" height="55" as="geometry" />
        </mxCell>

        <!-- ============================ distribution ============================ -->
        <mxCell id="ingest" value="dist-ingest&#10;release poller&#10;outbound only, no keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneDist">

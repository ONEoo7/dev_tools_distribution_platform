# Copy to `.env` and fill in. `.env` is gitignored.

# Required. The compose file refuses to start without it rather than
# defaulting, because a default database password is the kind of thing that
# survives into production unnoticed.
POSTGRES_PASSWORD=

# Creates the `admin` operator the first time the stack starts, and is ignored
# once any operator exists. Leave empty and use
# `python -m dist_admin.operators add <name>` if you would rather it never sat
# in a file.
ADMIN_BOOTSTRAP_PASSWORD=

# Read-only forge credential for the worker. Prefer FORGE_TOKEN_FILE: an
# environment variable is inherited by every child process and lands in a crash
# dump. Public GitHub repositories work with neither set, at a lower rate limit.
#FORGE_TOKEN_FILE=/run/secrets/forge_token
#FORGE_TOKEN=

# Where the services listen on the host. Both default to loopback.
#EDGE_BIND=127.0.0.1
#EDGE_PORT=8080
#ADMIN_BIND=127.0.0.1
#ADMIN_PORT=8081

# Set to 1 only when the admin plane is behind TLS. A Secure cookie is never
# sent over loopback HTTP, which presents as a login form that accepts the
# password and then returns you to the login form.
#ADMIN_SECURE_COOKIE=0

#LOG_LEVEL=INFO
